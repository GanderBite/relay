---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'Relay' ? title : `${title} · Relay`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e0e10" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-label="Toggle navigation" />
    <header class="topbar">
      <a class="topbar-brand" href={`${base}/`}>
        <span class="mark">●─▶●─▶●─▶●</span>
        <span class="tag">relay docs</span>
      </a>
      <label for="nav-toggle" class="hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </label>
    </header>
    <div class="shell">
      <Sidebar />
      <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>
      <main class="main">
        <slot />
        <footer class="page-footer">
          <p>
            Relay is MIT-licensed and dogfooded by <a href="https://ganderbite.com">Ganderbite</a>.
            Source on <a href="https://github.com/ganderbite/relay">GitHub</a>.
          </p>
        </footer>
      </main>
    </div>
  </body>
</html>
